{
  "name": "@roboflow/tfrecords",
  "version": "1.1.0",
  "description": "TensorFlow record (.tfrecord) API for Node.JS and Browsers",
  "main": "src/tensorFlowBuilder.js",
  "dependencies": {
    "buffer-reverse": "^1.0.1",
    "google-protobuf": "3.21.2",
    "node-int64": "^0.4.0",
    "shortid": "^2.2.14"
  },
  "types": "src/index.d.ts",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "eslint 'src/**/*.ts'",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/roboflow-ai/TFRecords.git"
  },
  "keywords": [
    "TFRecords",
    "TensorFlow"
  ],
  "author": "Jacopo Mangiavacchi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JacopoMangiavacchi/TFRecords/issues"
  },
  "homepage": "https://github.com/JacopoMangiavacchi/TFRecords#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^1.16.4",
    "ts-jest": "29.1.2",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src/**/*"
  ]
}
